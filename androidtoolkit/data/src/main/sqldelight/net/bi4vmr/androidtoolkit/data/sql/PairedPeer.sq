-- 已配对的对端（服务端批准的客户端，或客户端信任的服务端）。
CREATE TABLE paired_peer (
    fingerprint TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    paired_timestamp INTEGER NOT NULL,
    type TEXT NOT NULL
);

CREATE INDEX paired_peer_type ON paired_peer(type);

selectAll:
SELECT *
FROM paired_peer
ORDER BY paired_timestamp DESC;

selectByType:
SELECT *
FROM paired_peer
WHERE type = ?
ORDER BY paired_timestamp DESC;

selectByFingerprint:
SELECT *
FROM paired_peer
WHERE fingerprint = ?;

upsert:
INSERT OR REPLACE INTO paired_peer(fingerprint, name, paired_timestamp, type)
VALUES (?, ?, ?, ?);

deleteByFingerprint:
DELETE FROM paired_peer
WHERE fingerprint = ?;
