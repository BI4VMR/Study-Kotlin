CREATE TABLE device_record (
    id TEXT NOT NULL PRIMARY KEY,
    host TEXT NOT NULL,
    port INTEGER NOT NULL,
    create_time INTEGER NOT NULL,
    update_time INTEGER NOT NULL
);


queryAll:
SELECT *
FROM device_record
ORDER BY host AND port ASC;

queryByAddress:
SELECT *
FROM device_record
WHERE host = ? AND port = ?;

replace:
INSERT OR REPLACE INTO device_record(id, host, port, create_time, update_time)
VALUES (?, ?, ?, ?, ?);

deleteByID:
DELETE FROM device_record
WHERE id = ?;

deleteByAddress:
DELETE FROM device_record
WHERE host = ? AND port = ?;

checkIfExist:
SELECT EXISTS(SELECT 1 FROM device_record WHERE host = ? AND port = ?);
