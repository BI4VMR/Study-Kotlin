CREATE TABLE remote_executor (
    host TEXT NOT NULL,
    port INTEGER NOT NULL,
    enable_tls INTEGER NOT NULL,
    create_time INTEGER NOT NULL,
    PRIMARY KEY (host, port)
);


selectAll:
SELECT *
FROM remote_executor
ORDER BY create_time ASC;

replace:
INSERT OR REPLACE INTO remote_executor(host, port, enable_tls, create_time)
VALUES (?, ?, ?, ?);

deleteByAddress:
DELETE FROM remote_executor
WHERE host = ? AND port = ?;
